                            <ScrollViewer x:Name="PerfWorkspace" Grid.Row="3" Grid.RowSpan="2" Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Padding="30,26,30,24" Spacing="20" MaxWidth="1000" HorizontalAlignment="Stretch">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <Border Width="56" Height="56" Background="#1B304C" BorderBrush="#2D4E74" BorderThickness="1" CornerRadius="16">
                                            <FontIcon Glyph="&#xEC4A;" FontSize="25" Foreground="#91C2FF" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="Know your speed." FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="Time to first token, decode rate and memory for every generation, measured by the app on the Task stream."
                                                       Style="{StaticResource HintText}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#152336" BorderBrush="#29415E" BorderThickness="1" CornerRadius="9" Padding="16,14">
                                        <Grid ColumnSpacing="20" RowSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="PerfModel" Grid.Row="1" Text="No text model loaded" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="DEVICE" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="PerfDevice" Grid.Column="1" Grid.Row="1" Text="-" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="CONTEXT" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="PerfContext" Grid.Column="2" Grid.Row="1" Text="-" FontSize="13" />
                                            <TextBlock Grid.Column="3" Text="SESSION LOAD" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="PerfLoadTime" Grid.Column="3" Grid.Row="1" Text="-" FontSize="13" FontFamily="Cascadia Code,Consolas" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="GPU MEMORY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                                <Button Click="RefreshGpuMemory_Click" Padding="3" MinWidth="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                                                        AutomationProperties.Name="Refresh GPU memory" ToolTipService.ToolTip="This process's dedicated GPU memory (DXCore). Refresh">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock x:Name="PerfGpuMemory" Grid.Column="4" Grid.Row="1" Text="-" FontSize="13" FontFamily="Cascadia Code,Consolas"
                                                       AutomationProperties.AutomationId="PerfGpuMemory" />
                                        </Grid>
                                    </Border>

                                    <Border Background="#171E27" BorderBrush="{StaticResource StudioBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Benchmark" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="llama-bench style tests: pp evaluates a prompt of N tokens, tg generates N tokens one step at a time. Results are mean &#xB1; standard deviation in tokens per second."
                                                           Style="{StaticResource HintText}" />
                                            </StackPanel>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="BenchmarkPromptTokens" Header="Prompt (pp)" SelectedIndex="3" MinWidth="110"
                                                          AutomationProperties.AutomationId="BenchmarkPromptTokens" AutomationProperties.Name="Prompt processing tokens"
                                                          ToolTipService.ToolTip="llama-bench -p: prompt tokens evaluated in one step">
                                                    <ComboBoxItem Content="Off" Tag="0" />
                                                    <ComboBoxItem Content="128" Tag="128" />
                                                    <ComboBoxItem Content="256" Tag="256" />
                                                    <ComboBoxItem Content="512" Tag="512" />
                                                    <ComboBoxItem Content="1024" Tag="1024" />
                                                    <ComboBoxItem Content="2048" Tag="2048" />
                                                </ComboBox>
                                                <ComboBox x:Name="BenchmarkTokens" Grid.Column="1" Header="Generate (tg)" SelectedIndex="3" MinWidth="110"
                                                          AutomationProperties.AutomationId="BenchmarkTokens" AutomationProperties.Name="Text generation tokens"
                                                          ToolTipService.ToolTip="llama-bench -n: tokens generated from a one-token prompt">
                                                    <ComboBoxItem Content="Off" Tag="0" />
                                                    <ComboBoxItem Content="32" Tag="32" />
                                                    <ComboBoxItem Content="64" Tag="64" />
                                                    <ComboBoxItem Content="128" Tag="128" />
                                                    <ComboBoxItem Content="256" Tag="256" />
                                                    <ComboBoxItem Content="512" Tag="512" />
                                                </ComboBox>
                                                <ComboBox x:Name="BenchmarkDepth" Grid.Column="2" Header="Depth (d)" SelectedIndex="0" MinWidth="100"
                                                          AutomationProperties.AutomationId="BenchmarkDepth" AutomationProperties.Name="Context depth"
                                                          ToolTipService.ToolTip="llama-bench -d: tokens already in the context (KV cache) before each test">
                                                    <ComboBoxItem Content="0" Tag="0" />
                                                    <ComboBoxItem Content="512" Tag="512" />
                                                    <ComboBoxItem Content="1024" Tag="1024" />
                                                    <ComboBoxItem Content="2048" Tag="2048" />
                                                    <ComboBoxItem Content="4096" Tag="4096" />
                                                </ComboBox>
                                                <ComboBox x:Name="BenchmarkRuns" Grid.Column="3" Header="Repetitions (r)" SelectedIndex="1" MinWidth="110"
                                                          AutomationProperties.Name="Benchmark repetitions" ToolTipService.ToolTip="llama-bench -r: measured runs per test">
                                                    <ComboBoxItem Content="3" Tag="3" />
                                                    <ComboBoxItem Content="5" Tag="5" />
                                                    <ComboBoxItem Content="10" Tag="10" />
                                                    <ComboBoxItem Content="20" Tag="20" />
                                                </ComboBox>
                                                <ComboBox x:Name="BenchmarkWarmup" Grid.Column="4" Header="Warm-up" SelectedIndex="2" MinWidth="90"
                                                          AutomationProperties.Name="Warm-up runs" ToolTipService.ToolTip="Unmeasured runs per test before the repetitions. The first runs after loading a model are slower">
                                                    <ComboBoxItem Content="0" Tag="0" />
                                                    <ComboBoxItem Content="1" Tag="1" />
                                                    <ComboBoxItem Content="2" Tag="2" />
                                                    <ComboBoxItem Content="3" Tag="3" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BenchmarkHint" Text="Load a text model in the sidebar to benchmark it." Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="StopBenchmarkButton" Content="Stop" Click="StopBenchmark_Click" Visibility="Collapsed"
                                                            Style="{StaticResource QuietButton}" Foreground="#FFAAA5" />
                                                    <Button x:Name="BenchmarkButton" Click="Benchmark_Click" IsEnabled="False" CornerRadius="7" Padding="18,9"
                                                            Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BenchmarkButton">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                            <TextBlock Text="Run benchmark" FontSize="12" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel x:Name="PerfSummaryPanel" Spacing="10" Visibility="Collapsed">
