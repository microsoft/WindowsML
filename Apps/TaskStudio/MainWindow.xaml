                                                    <ComboBoxItem Content="Short (3 prompts)" Tag="0" />
                                                    <ComboBoxItem Content="Coding, 4K context" Tag="4096" />
                                                    <ComboBoxItem Content="Coding, 8K context" Tag="8192" />
                                                    <ComboBoxItem Content="Coding, 16K context" Tag="16384" />
                                                    <ComboBoxItem Content="Coding, ~30K (all files)" Tag="32768" />
