                                                                        <TextBlock Grid.Column="5" Text="{x:Bind Accepted}" FontFamily="Cascadia Code,Consolas" FontSize="12" HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="6" Text="{x:Bind AcceptRate}" FontFamily="Cascadia Code,Consolas" FontSize="12" HorizontalAlignment="Right" />
                                                                        <TextBlock Grid.Column="7" Text="{x:Bind TokensPerStep}" FontFamily="Cascadia Code,Consolas" FontSize="12" HorizontalAlignment="Right" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock x:Name="SpeculativeDetail" Style="{StaticResource HintText}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <TextBlock Text="GENERATION HISTORY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button x:Name="ClearPerfButton" Click="ClearPerf_Click" Style="{StaticResource QuietButton}" IsEnabled="False"
