                                                                <DataTemplate x:DataType="local:SpeculativeRowItem">
                                                                    <Grid ColumnSpacing="12" Padding="0,6" BorderBrush="#222B36" BorderThickness="0,1,0,0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition /><ColumnDefinition Width="150" /><ColumnDefinition Width="56" /><ColumnDefinition Width="86" />
                                                                            <ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{x:Bind PromptLabel}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind Method}" FontSize="12" FontWeight="SemiBold" />
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind Generated}" FontFamily="Cascadia Code,Consolas" FontSize="12" HorizontalAlignment="Right" />
