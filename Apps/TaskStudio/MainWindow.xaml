                                                    <ComboBoxItem Content="Stop" Tag="stop" />
                                                    <ComboBoxItem Content="Ignore (full count)" Tag="ignore" />
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SpeculativeCompareHint" Text="Load a model with a speculative decoding method to compare it." Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="CopySpeculativeButton" Content="Copy as Markdown" Click="CopySpeculative_Click" IsEnabled="False"
                                                            Style="{StaticResource QuietButton}" />
                                                    <Button x:Name="SpeculativeCompareButton" Click="SpeculativeCompare_Click" IsEnabled="False" CornerRadius="7" Padding="18,9"
                                                            Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SpeculativeCompareButton">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                                                            <TextBlock Text="Compare" FontSize="12" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="SpeculativeResultsPanel" Spacing="10" Visibility="Collapsed">
                                                <TextBlock x:Name="SpeculativeSpeedup" FontSize="22" FontWeight="SemiBold" Foreground="#79D5A1"
                                                           AutomationProperties.AutomationId="SpeculativeSpeedup" />
                                                <Border Background="#151B23" BorderBrush="#28323E" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                                    <StackPanel Spacing="2">
                                                        <Grid ColumnSpacing="12" Padding="0,2,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition /><ColumnDefinition Width="150" /><ColumnDefinition Width="56" /><ColumnDefinition Width="86" />
                                                                <ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="PROMPT" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Grid.Column="1" Text="METHOD" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Grid.Column="2" Text="OUT" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="3" Text="DECODE T/S" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="4" Text="DRAFTED" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="5" Text="ACCEPTED" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="6" Text="ACCEPT" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                            <TextBlock Grid.Column="7" Text="TOK/STEP" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{x:Bind SpeculativeRows}">
