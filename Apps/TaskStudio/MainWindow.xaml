                                        </Grid>
                                        <Border Background="#151B23" BorderBrush="#28323E" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnSpacing="10" Padding="0,2,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" /><ColumnDefinition Width="92" /><ColumnDefinition Width="64" /><ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="72" /><ColumnDefinition Width="80" /><ColumnDefinition Width="64" /><ColumnDefinition Width="130" /><ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="TIME" Style="{StaticResource SectionLabel}" />
