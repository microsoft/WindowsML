                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <ComboBox x:Name="SpeculativePromptSet" Header="Prompts" SelectedIndex="0" MinWidth="190"
                                                          SelectionChanged="SpeculativePromptSet_SelectionChanged"
                                                          AutomationProperties.AutomationId="SpeculativePromptSet" AutomationProperties.Name="Prompt set"
