                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <Border Background="#151B23" BorderBrush="#28323E" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Name="PerfPromptLabel" Text="Prompt processing" FontSize="12" Foreground="{StaticResource StudioSecondary}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock x:Name="PerfPrompt" Text="-" FontSize="28" FontWeight="SemiBold" Foreground="#79B4FF" AutomationProperties.AutomationId="PerfPrompt" />
                                                        <TextBlock Text="tok/s" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="{StaticResource StudioSecondary}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="PerfPromptRange" FontSize="10" Foreground="{StaticResource StudioMuted}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#151B23" BorderBrush="#28323E" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Name="PerfDecodeLabel" Text="Text generation" FontSize="12" Foreground="{StaticResource StudioSecondary}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock x:Name="PerfDecode" Text="-" FontSize="28" FontWeight="SemiBold" Foreground="#79B4FF" AutomationProperties.AutomationId="PerfDecode" />
                                                        <TextBlock Text="tok/s" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="{StaticResource StudioSecondary}" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="PerfDecodeRange" FontSize="10" Foreground="{StaticResource StudioMuted}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="#151B23" BorderBrush="#28323E" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Prompt time" FontSize="12" Foreground="{StaticResource StudioSecondary}" />
                                                    <TextBlock x:Name="PerfTtft" Text="-" FontSize="28" FontWeight="SemiBold" AutomationProperties.AutomationId="PerfTtft" />
                                                    <TextBlock x:Name="PerfTtftRange" FontSize="10" Foreground="{StaticResource StudioMuted}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="#151B23" BorderBrush="#28323E" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Per generated token" FontSize="12" Foreground="{StaticResource StudioSecondary}" />
                                                    <TextBlock x:Name="PerfMsPerToken" Text="-" FontSize="28" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PerfMsPerTokenRange" FontSize="10" Foreground="{StaticResource StudioMuted}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <Border Background="#151B23" BorderBrush="#28323E" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnSpacing="12" Padding="0,2,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="MODEL" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="1" Text="TEST" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="2" Text="T/S" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="3" Text="MS" Style="{StaticResource SectionLabel}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Column="4" Text="NOTES" Style="{StaticResource SectionLabel}" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{x:Bind BenchmarkRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:BenchmarkRowItem">
                                                            <Grid ColumnSpacing="12" Padding="0,6" BorderBrush="#222B36" BorderThickness="0,1,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="90" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind Model}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind Test}" FontFamily="Cascadia Code,Consolas" FontSize="12" FontWeight="SemiBold" />
                                                                <TextBlock Grid.Column="2" Text="{x:Bind Rate}" FontFamily="Cascadia Code,Consolas" FontSize="12" Foreground="#79B4FF"
                                                                           HorizontalAlignment="Right" AutomationProperties.AutomationId="BenchmarkRate" />
                                                                <TextBlock Grid.Column="3" Text="{x:Bind Milliseconds}" FontFamily="Cascadia Code,Consolas" FontSize="12" HorizontalAlignment="Right" />
                                                                <TextBlock Grid.Column="4" Text="{x:Bind Note}" FontSize="10" Foreground="{StaticResource StudioMuted}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="PerfSummaryDetail" Style="{StaticResource HintText}" AutomationProperties.AutomationId="PerfSummaryDetail" />
                                    </StackPanel>

                                    <Border Background="#171E27" BorderBrush="{StaticResource StudioBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Speculative decoding: Off vs on" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Runs the same greedy prompts with speculation off, then with the loaded method, and checks the text is identical. Decode speed, drafted and accepted tokens come from the Runtime's per-stream statistics."
                                                           Style="{StaticResource HintText}" />
                                                <Expander Header="Prompts used" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                                                    <TextBlock x:Name="SpeculativePromptList" Style="{StaticResource HintText}" FontFamily="Cascadia Code,Consolas"
                                                               IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                                </Expander>
