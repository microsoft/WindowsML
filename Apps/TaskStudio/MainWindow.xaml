                                                    <TextBlock Grid.Column="2" Text="PROMPT" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="3" Text="OUT" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="4" Text="TTFT MS" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="5" Text="DECODE T/S" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="6" Text="MS/TOK" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="7" Text="TOTAL MS" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Grid.Column="8" Text="MODEL / NOTES" Style="{StaticResource SectionLabel}" />
                                                </Grid>
                                                <TextBlock x:Name="PerfHistoryEmpty" Text="Generations from Chat, Completion and benchmarks appear here."
                                                           Style="{StaticResource HintText}" Margin="0,4,0,6" />
                                                <ItemsControl ItemsSource="{x:Bind PerfRuns}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:PerfRunItem">
                                                            <Grid ColumnSpacing="10" Padding="0,5" BorderBrush="#222B36" BorderThickness="0,1,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="64" /><ColumnDefinition Width="92" /><ColumnDefinition Width="64" /><ColumnDefinition Width="64" />
                                                                    <ColumnDefinition Width="72" /><ColumnDefinition Width="80" /><ColumnDefinition Width="64" /><ColumnDefinition Width="130" /><ColumnDefinition />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{x:Bind Time}" FontFamily="Cascadia Code,Consolas" FontSize="11" Foreground="{StaticResource StudioSecondary}" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind Source}" FontSize="12" />
                                                                <TextBlock Grid.Column="2" Text="{x:Bind PromptTokens}" FontFamily="Cascadia Code,Consolas" FontSize="11" />
                                                                <TextBlock Grid.Column="3" Text="{x:Bind GeneratedTokens}" FontFamily="Cascadia Code,Consolas" FontSize="11" />
                                                                <TextBlock Grid.Column="4" Text="{x:Bind Ttft}" FontFamily="Cascadia Code,Consolas" FontSize="11" />
                                                                <TextBlock Grid.Column="5" Text="{x:Bind Decode}" FontFamily="Cascadia Code,Consolas" FontSize="11" Foreground="#79B4FF"
                                                                           AutomationProperties.AutomationId="PerfRowDecode" />
                                                                <TextBlock Grid.Column="6" Text="{x:Bind MsPerToken}" FontFamily="Cascadia Code,Consolas" FontSize="11" />
                                                                <TextBlock Grid.Column="7" Text="{x:Bind Total}" FontFamily="Cascadia Code,Consolas" FontSize="11" />
                                                                <StackPanel Grid.Column="8">
                                                                    <TextBlock Text="{x:Bind Model}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Note}" FontSize="10" Foreground="{StaticResource StudioMuted}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Times are host wall clock from the request call, measured by the app as it reads the Task stream. Completion counts every token; Chat sees parser deltas, which can hold text back, so its decode rate may be unavailable. Prompt cache use shows when the Runtime reports it."
                                                   FontSize="10" Foreground="{StaticResource StudioMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Background="#12171D" BorderBrush="{StaticResource StudioBorder}" BorderThickness="0,1,0,0" Padding="20,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="5" Height="5" Fill="#79B4FF" />
                <TextBlock Text="Windows ML Runtime" FontSize="10" Foreground="{StaticResource StudioSecondary}" />
                <TextBlock Text="Task API" FontSize="10" Foreground="{StaticResource StudioMuted}" />
            </StackPanel>
            <TextBlock x:Name="TaskFamilyLabel" Text="Chat Completion" FontSize="10" Foreground="{StaticResource StudioMuted}"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
