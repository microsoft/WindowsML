                                                    <ComboBoxItem Content="128" Tag="128" />
                                                    <ComboBoxItem Content="256" Tag="256" />
                                                    <ComboBoxItem Content="512" Tag="512" />
                                                    <ComboBoxItem Content="1,024" Tag="1024" />
                                                    <ComboBoxItem Content="2,048" Tag="2048" />
                                                    <ComboBoxItem Content="4,096" Tag="4096" />
                                                    <ComboBoxItem Content="8,192" Tag="8192" />
                                                    <ComboBoxItem Content="16,384" Tag="16384" />
                                                    <ComboBoxItem Content="32,768" Tag="32768" />
                                                </ComboBox>
                                                <ComboBox x:Name="SpeculativeEndOfText" Grid.Column="2" Header="End of text" SelectedIndex="0" MinWidth="150"
                                                          AutomationProperties.AutomationId="SpeculativeEndOfText" AutomationProperties.Name="End of text"
