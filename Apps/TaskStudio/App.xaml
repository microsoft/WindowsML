<Application
    x:Class="TaskStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="StudioBackground" Color="#0F1216" />
            <SolidColorBrush x:Key="StudioSidebar" Color="#151A21" />
            <SolidColorBrush x:Key="StudioSurface" Color="#1B222B" />
            <SolidColorBrush x:Key="StudioBorder" Color="#28323E" />
            <SolidColorBrush x:Key="StudioText" Color="#E6EDF3" />
            <SolidColorBrush x:Key="StudioSecondary" Color="#9AA7B4" />
            <SolidColorBrush x:Key="StudioMuted" Color="#7F8C9C" />
            <SolidColorBrush x:Key="StudioAccent" Color="#2F81F7" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2F81F7" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#4892FC" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#79B4FF" />
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource StudioText}" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="150" />
                <Setter Property="Foreground" Value="{StaticResource StudioSecondary}" />
            </Style>
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource StudioMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineHeight" Value="18" />
            </Style>
            <Style x:Key="StudioInput" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource StudioSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,9" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="StarterButton" TargetType="Button">
                <Setter Property="Background" Value="#171E28" />
                <Setter Property="BorderBrush" Value="#2C3B50" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
