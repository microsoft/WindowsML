<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (C) Microsoft Corporation. All rights reserved.

  Shared package versions for every sample catalog. Projects may override
  WinMLRuntimePackageVersion and WinMLLibLlamaPackageVersion from the command
  line while the repository keeps one default for each.

  Microsoft.Windows.AI.MachineLearning.LibLlama.Core depends on exactly the
  Microsoft.Windows.AI.MachineLearning version it was built with, so the two
  versions must come from the same Windows ML release. The documentation
  refers to these two defaults instead of restating them, and derives the
  matching Python wheel version from WinMLRuntimePackageVersion.

  Microsoft.Windows.AI.MachineLearning depends on exactly the Direct3D 12
  Agility SDK package (Microsoft.Direct3D.D3D12) it was built with. NuGet
  restores it as a transitive dependency.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <WinMLRuntimePackageVersion Condition="'$(WinMLRuntimePackageVersion)' == ''">2.9.31-experimental</WinMLRuntimePackageVersion>
    <WinMLLibLlamaPackageVersion Condition="'$(WinMLLibLlamaPackageVersion)' == ''">0.7.0.102-experimental</WinMLLibLlamaPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning" Version="$(WinMLRuntimePackageVersion)" />
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning.LibLlama.Core" Version="$(WinMLLibLlamaPackageVersion)" />
    <PackageVersion Include="Microsoft.Windows.ImplementationLibrary" Version="1.0.240803.1" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.335" />
  </ItemGroup>
</Project>
