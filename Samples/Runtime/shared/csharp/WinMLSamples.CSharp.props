<!--
  Copyright (C) Microsoft Corporation. All rights reserved.

  Shared settings for the C# Windows ML samples in Samples\Runtime and
  Samples\Tasks. Each sample project imports this file after its own
  PropertyGroup.

  The samples call the Runtime and Task APIs through bindings that CsWin32
  generates from the Win32 metadata in the Microsoft.Windows.AI.MachineLearning
  package. The package's managed assemblies supply the execution-provider
  catalog (Microsoft.Windows.AI.MachineLearning) and the ONNX Runtime C# API
  (Microsoft.ML.OnnxRuntime) that the samples use to register a provider that
  the ep option names and to raise ONNX Runtime logging for the verbose option.

  Set WinMLSampleOutputRoot before importing this file to choose the catalog's
  out directory.
-->
<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated bindings use unmanaged pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    A runtime identifier places the package's native DLLs next to the
    executable, where the Runtime loads its dependencies from. Without an
    explicit x64 or ARM64 platform, build for the host architecture.
  -->
  <PropertyGroup>
    <_SampleArchitecture Condition="'$(Platform)' == 'x64'">x64</_SampleArchitecture>
    <_SampleArchitecture Condition="'$(Platform)' == 'ARM64'">arm64</_SampleArchitecture>
    <_SampleArchitecture Condition="'$(_SampleArchitecture)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_SampleArchitecture>
    <_SamplePlatform Condition="'$(_SampleArchitecture)' == 'arm64'">ARM64</_SamplePlatform>
    <_SamplePlatform Condition="'$(_SamplePlatform)' == ''">$(_SampleArchitecture)</_SamplePlatform>
    <RuntimeIdentifier>win-$(_SampleArchitecture)</RuntimeIdentifier>
    <PlatformTarget>$(_SampleArchitecture)</PlatformTarget>
    <SelfContained>false</SelfContained>
    <WinMLSampleOutputRoot Condition="'$(WinMLSampleOutputRoot)' == ''">$(MSBuildThisFileDirectory)..\..\out\</WinMLSampleOutputRoot>
    <OutDir>$(WinMLSampleOutputRoot)$(_SamplePlatform)\$(Configuration)\$(AssemblyName)\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Shared helpers and the APIs they use. CsWin32 combines every
    NativeMethods.txt in AdditionalFiles, so each project lists only the APIs
    its own code adds. NativeMethods.json sets the generation options for all
    of them.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)*.cs" Link="Shared\%(Filename)%(Extension)" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)NativeMethods.txt" Link="Shared\NativeMethods.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)NativeMethods.json" Link="NativeMethods.json" />
  </ItemGroup>
</Project>
