<configuration>
  <packageSources>
    <clear />
    <add key="winml-local" value="localpackages"/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSourceMapping>
    <packageSource key="winml-local">
      <package pattern="Microsoft.Windows.AI.MachineLearning" />
      <package pattern="Microsoft.Windows.AI.MachineLearning.LibLlama*" />
      <package pattern="Microsoft.Direct3D.*" />
      <package pattern="Microsoft.Windows.SDK.NET.Ref" />
      <package pattern="Microsoft.Windows.ImplementationLibrary" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.Windows.AI.MachineLearning" />
      <package pattern="Microsoft.Windows.AI.MachineLearning.LibLlama*" />
      <package pattern="Microsoft.Direct3D.*" />
      <package pattern="Microsoft.Windows.SDK.NET.Ref" />
      <package pattern="Microsoft.Windows.ImplementationLibrary" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
