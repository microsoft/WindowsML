    <AssemblyName>hello-language-model-csharp</AssemblyName>
    <RootNamespace>HelloLanguageModel</RootNamespace>
  </PropertyGroup>

  <Import Project="..\..\..\shared\csharp\WinMLSamples.CSharp.props" />

