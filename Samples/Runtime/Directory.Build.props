<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright (C) Microsoft Corporation. All rights reserved.

  Shared MSBuild properties for all Windows ML Runtime samples.
  Automatically imported by MSBuild for all .vcxproj files in child directories.

  These samples consume the Windows ML Runtime through the
  Microsoft.Windows.AI.MachineLearning NuGet package (PackageReference +
  Central Package Management) by default. The package carries the Runtime
  facade headers and the winml/tensors/*.h adapter headers, so
  <winml/tensors/WinMLTensors.h> resolves through normal package restore.
  Directory.Build.props.user can override package paths for local builds.
-->
<Project>
  <!-- Import user overrides (gitignored) when present -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <!-- C++ standard -->
    <LanguageStandard>stdcpp20</LanguageStandard>
    <LanguageStandard_C>stdc17</LanguageStandard_C>

    <!-- Output directories -->
    <OutDir>$(SolutionDir)out\$(Platform)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>

    <!-- Platform defaults -->
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Auto-detect platform toolset: VS 2026 (v145), VS 2022 (v143). -->
    <PlatformToolset Condition="'$(PlatformToolset)' == '' And '$(MSBuildToolsVersion)' >= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <TargetFramework>native</TargetFramework>
    <ResolveNuGetPackages>false</ResolveNuGetPackages>

    <!-- Shared include path for common + tensorization helpers -->
    <WinMLSamplesSharedDir>$(MSBuildThisFileDirectory)shared\</WinMLSamplesSharedDir>

    <!-- NuGet package restore -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <!-- The NuGet package .props/.targets handle include paths, import
       libraries, and DLL copy. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <AdditionalIncludeDirectories Condition="'$(WinMLRuntimeLocalIncludeDir)' != ''">$(WinMLRuntimeLocalIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories>$(WinMLSamplesSharedDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <ConformanceMode>true</ConformanceMode>
      <SDLCheck>true</SDLCheck>
    </ClCompile>
    <Link>
      <AdditionalDependencies Condition="'$(WinMLRuntimeLocalLibDir)' != ''">WinMLRuntimeCore.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalDependencies>ole32.lib;oleaut32.lib;d3d12.lib;dxgi.lib;dxcore.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
