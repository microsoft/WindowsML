<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
  <PropertyGroup>
    <LanguageStandard>stdcpp20</LanguageStandard>
    <LanguageStandard_C>stdc17</LanguageStandard_C>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <PlatformToolset Condition="'$(PlatformToolset)' == '' And '$(MSBuildToolsVersion)' >= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <TargetFramework>native</TargetFramework>
    <ResolveNuGetPackages>false</ResolveNuGetPackages>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <OutDir>$(MSBuildThisFileDirectory)out\$(Platform)\$(Configuration)\$(ProjectName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
    <WinMLTaskSamplesSharedDir>$(MSBuildThisFileDirectory)shared\</WinMLTaskSamplesSharedDir>
    <WinMLRuntimeSamplesSharedDir>$(MSBuildThisFileDirectory)..\Runtime\shared\</WinMLRuntimeSamplesSharedDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <AdditionalIncludeDirectories Condition="'$(WinMLRuntimeLocalIncludeDir)' != ''">$(WinMLRuntimeLocalIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories>$(WinMLTaskSamplesSharedDir);$(WinMLRuntimeSamplesSharedDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <ConformanceMode>true</ConformanceMode>
      <SDLCheck>true</SDLCheck>
    </ClCompile>
    <Link>
      <AdditionalDependencies Condition="'$(WinMLRuntimeLocalLibDir)' != ''">WinMLRuntimeCore.lib;WinMLTasks.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalDependencies>ole32.lib;oleaut32.lib;d3d12.lib;dxgi.lib;dxcore.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
